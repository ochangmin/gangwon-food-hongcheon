# 강원 먹거리 이음 — 자체 설치형 서버 설정
# 이 파일을 .env 로 복사한 뒤 필요한 값만 고치세요. (# 으로 시작하는 줄은 무시)

# 서버 주소
PORT=8080
HOST=0.0.0.0

# 자료 저장 위치 (회원 계정·업무 자료·자동 백업). 이 폴더를 정기적으로 다른 곳에 복사해 두세요.
STORAGE_DIR=storage
BACKUP_KEEP_DAYS=30

# HTTPS — 인증서가 있으면 경로를 넣으세요. (없으면 http 로 시작합니다)
# TLS_CERT=C:\certs\fullchain.pem
# TLS_KEY=C:\certs\privkey.pem
# Nginx·Caddy·IIS 같은 HTTPS 프록시 뒤에서 돌리면 1
TRUST_PROXY=0

# 암호화 키 (권장): 비워 두면 저장소 첫 사용 때 자동 생성되어 저장소 안에 함께 보관됩니다.
# 키를 저장소와 따로 두려면 아래 명령으로 만든 값을 넣으세요. 바꾸거나 잃어버리면 기존 자료를 읽을 수 없습니다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DATA_ENC_KEY=

# 최초 관리자 설정 코드: 비워 두면 처음 시작할 때 만들어 storage/setup-code.txt 에 둡니다.
# ADMIN_SETUP_CODE=

# 외부 Upstash 를 계속 쓰려면 (비우면 내장 저장소)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 지도 항공영상(브이월드) 키 — 이 서버 주소로 발급받은 키. 없으면 Esri 영상으로 자동 전환
# VWORLD_KEY=

# 접속 기록을 화면에 모두 남기려면 1
ACCESS_LOG=0
